<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/ios_bg"
    android:padding="14dp">

    <!-- 상단 바: 뒤로(재촬영) / 타이틀 (iOS 스타일) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_ios_card"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ios_blue"
            android:contentDescription="back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/edit_title"
            android:textColor="@color/ios_label"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 이미지 프리뷰 카드 (라운드) -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="false"
        android:background="@drawable/bg_ios_image"
        android:clipToOutline="true"
        android:scaleType="fitCenter"
        android:contentDescription="preview" />

    <TextView
        android:id="@+id/noticeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/ios_secondary"
        android:textSize="13sp" />

    <!-- 보정 카드: 통합 슬라이더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ios_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/adjust_label"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valEnhance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderEnhance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="100"
            android:value="50" />
    </LinearLayout>

    <!-- 하단 버튼 행: 4개 동일 규격으로 정렬 고정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRetake"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:backgroundTint="@color/ios_gray_btn"
            android:text="@string/btn_retake"
            android:textColor="@color/ios_label"
            android:textSize="13sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:backgroundTint="@color/ios_gray_btn"
            android:text="@string/btn_toggle_original"
            android:textColor="@color/ios_label"
            android:textSize="13sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnManualCrop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:backgroundTint="@color/ios_gray_btn"
            android:text="@string/btn_manual_crop"
            android:textColor="@color/ios_label"
            android:textSize="13sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:backgroundTint="@color/ios_blue"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
